rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper for validating shared ownership field in creating/updating
    function checkUserId(data) {
       return data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /ingredientes/{ingredienteId} {
      allow read: if isDocOwner();
      allow create: if isSignedIn() && checkUserId(request.resource.data) && isValidId(ingredienteId);
      allow update: if isDocOwner() && checkUserId(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /marmitas/{marmitaId} {
      allow read: if isDocOwner();
      allow create: if isSignedIn() && checkUserId(request.resource.data) && isValidId(marmitaId);
      allow update: if isDocOwner() && checkUserId(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /compras/{compraId} {
      allow read: if isDocOwner();
      allow create: if isSignedIn() && checkUserId(request.resource.data) && isValidId(compraId);
      allow update: if isDocOwner() && checkUserId(request.resource.data);
      allow delete: if isDocOwner();
    }
  }
}
